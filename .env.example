# ---- App ----
APP_ENV=dev
# REQUIRED in production. Leave empty in dev: a random secret is generated per process.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://sa:sa@localhost:5435/sa_assistant

# ---- Redis (pub/sub, live STT sessions) ----
REDIS_URL=redis://localhost:6380/0

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9005
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sa-assistant
S3_REGION=us-east-1

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Bootstrap service owner (created on first startup) ----
# REQUIRED in production. Leave empty in dev: a random password is generated and logged.
BOOTSTRAP_OWNER_LOGIN=admin
BOOTSTRAP_OWNER_PASSWORD=
