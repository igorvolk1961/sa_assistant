# Скопируйте в deploy/.env и заполните реальными значениями:
#   cp env.production.example .env
# Сгенерировать секрет: openssl rand -hex 32

# --- Публикация ---
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=sa
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sa_assistant

# --- Backend ---
APP_ENV=production
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
BOOTSTRAP_OWNER_LOGIN=admin
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_strong_owner_password

# имя сервиса postgres/redis — внутренние адреса docker-сети
DATABASE_URL=postgresql+asyncpg://sa:CHANGE_ME_strong_db_password@postgres:5432/sa_assistant
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://212.67.8.112
